div.wpcf7-mail-sent-ok {
    border: 2px solid transparent;
    background-color: lightgreen;
    border-radius: 0px;
    padding: 10px 20px;
    color: darkgreen;
    font-size: 16px;
    line-height: 1.2em;
}

div.wpcf7-spam-blocked {
    border: 2px solid transparent;
    background-color: #b51111;
    border-radius: 0px;
    color: whitesmoke;
    line-height: 1.2em;
}
#wpcf7-f13814-p13806-o1 .ajax-loader, #wpcf7-f13814-p13806-o2 .ajax-loader{    width: 100% !important;
    height: 30px !important;
    background-image: url(https://eswindows.com/wp-content/uploads/2019/04/cargando-blanco.gif) !important;
    background-repeat: no-repeat;
    background-size: contain;
    background-position: left;
    margin-top: 10px;}
