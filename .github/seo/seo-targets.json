{
  "$schema_version": 1,
  "_about": [
    "Priority target definitions for the ACG SEO measurement layer.",
    "Read by .github/scripts/seo_measure/. Contains NO secrets and NO metric values -",
    "only the target set and the thresholds used to score it. Metric values arrive at",
    "runtime from GSC CSV exports / API snapshots (.github/seo/data/) and from",
    "manual-metrics.json for sources with no API.",
    "Edit this file to change what the weekly report tracks. Runbook: .github/scripts/seo_measure/README.md"
  ],
  "property": {
    "gsc_property": "sc-domain:acglass.com"
  },
  "thresholds": {
    "_about": "Position bands follow the 10-results-per-page convention used throughout the strategy docs.",
    "page1_max_position": 10.0,
    "page2_max_position": 20.0,
    "page3_max_position": 30.0,
    "striking_distance": {
      "_about": "Page 2-3. Queries here are the cheapest page-1 wins and drive the weekly action list.",
      "min_position": 10.0,
      "max_position": 30.0
    },
    "movement": {
      "_about": "A query must clear min_impressions in at least one period before a position delta is reported, so low-sample noise stays out of the summary.",
      "min_impressions": 10,
      "material_position_delta": 1.0
    },
    "cannibalization": {
      "_about": [
        "A query is flagged when 2+ ACG URLs both draw real impression volume for it.",
        "Definition per strategy doc: two or more ACG URLs competing for the same intent.",
        "Requires a query+page dimensioned dataset; query-only exports cannot detect this."
      ],
      "min_urls": 2,
      "min_impressions_per_url": 5,
      "min_impression_share_per_url": 0.1,
      "high_severity_page1_urls": 2,
      "high_severity_min_share": 0.3
    }
  },
  "query_groups": [
    {
      "id": "brand",
      "label": "Brand / navigational",
      "queries": [
        "american commercial glass",
        "acg glass contractor",
        "american commercial glass florida",
        "who is american commercial glass"
      ]
    },
    {
